# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.env

# Tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local (user-specific) config — only the example is tracked
config/config.yaml

# Project data / artifacts
data/historical/*.csv
data/historical/*.parquet
data/db/*.sqlite
data/db/session_*.json
data/db/*.lock
logs/*.log
# Generated backtest/report output — any reports* directory (reports/,
# reports_improved/, reports_test/, ...). Keep generated artifacts out of git.
reports/
reports_*/
# Canonical strategy-report output (`forex-bot report` writes results/*.csv|md).
results/
# Backtest result dumps written by the CLI (e.g. h4_donchian_result.txt). Match
# only *_result.txt so tracked text files like requirements.txt stay tracked —
# a bare *.txt rule here would silently ignore requirements.txt.
*_result.txt

# OS / editor
.DS_Store
.idea/
.vscode/
*.bak
