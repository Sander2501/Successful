# Capital.com API credentials.
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
#
# Generate an API key in the Capital.com web platform under:
#   Settings -> API integrations
#
# Demo and live use different base URLs. Start with demo.

# One of: "demo" | "live"
CAPITAL_ENVIRONMENT=demo

# Your Capital.com login email and password.
CAPITAL_IDENTIFIER=you@example.com
CAPITAL_PASSWORD=your-account-password

# The API key created in Settings -> API integrations.
CAPITAL_API_KEY=your-api-key

# Optional: custom API password set when creating the key (if you set one).
# Leave blank to use CAPITAL_PASSWORD for the session login.
CAPITAL_API_PASSWORD=

# Base URLs (defaults shown; usually no need to change).
CAPITAL_DEMO_BASE_URL=https://demo-api-capital.backend-capital.com
CAPITAL_LIVE_BASE_URL=https://api-capital.backend-capital.com
CAPITAL_DEMO_WS_URL=wss://api-streaming-capital.backend-capital.com/connect
CAPITAL_LIVE_WS_URL=wss://api-streaming-capital.backend-capital.com/connect
